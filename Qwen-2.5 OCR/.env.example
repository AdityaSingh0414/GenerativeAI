# Qwen 2.5-VL OCR Configuration
# Copy this file to .env and configure your keys

# Ollama local endpoint (default is http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Alibaba Cloud DashScope API (for Qwen API backend)
# Get a key from: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# OpenRouter API (Alternative cloud provider for Qwen 2.5-VL)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face API Token (for HF Serverless API)
HF_TOKEN=your_huggingface_token_here
